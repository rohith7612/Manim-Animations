# Copy to .env and fill in what you need. .env is git-ignored.

# OpenAI: transcription (gpt-transcribe + whisper-1) and planning. Optional:
# without a key, local Faster-Whisper and the built-in planner are used.
# The key can also be entered in the studio's Settings dialog (kept in memory only).
OPENAI_API_KEY=
# Planning model (default gpt-5.5). Can also be changed in Settings.
OPENAI_MODEL=

# Python that runs the studio (default: .venv created by the start script).
FRAMECRAFT_PYTHON=
# Python with Manim Community installed, if Manim lives in a separate environment.
MANIM_PYTHON=
# Node.js 22.12+ for the optional procedural 3D renderer (default: node on PATH).
FRAMECRAFT_NODE=
# Chrome or Edge executable for headless 3D rendering (auto-detected on common paths).
FRAMECRAFT_BROWSER=

# Where projects, renders and caches are stored (default: ./data).
FRAMECRAFT_DATA=
FRAMECRAFT_PORT=8765

# Local transcription fallback (used without an OpenAI key).
WHISPER_MODEL=small
WHISPER_CACHE=
